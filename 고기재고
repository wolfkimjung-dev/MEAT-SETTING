      meatStats[r.category].kg += r.buy_kg;
      meatStats[r.category].amt += r.buy_amt;
    }
  });

  document.getElementById('meat-summary-cards').innerHTML = `
    <div class="card"><small>🐷 돼지고기 순구매 / 금액</small><strong>${fmtKg(meatStats["돼지고기"].kg)} KG</strong><div style="font-size:12px;color:#1e40af;margin-top:2px;">₱ ${fmt(meatStats["돼지고기"].amt)}</div></div>
    <div class="card"><small>🐮 소고기 순구매 / 금액</small><strong>${fmtKg(meatStats["소고기"].kg)} KG</strong><div style="font-size:12px;color:#1e40af;margin-top:2px;">₱ ${fmt(meatStats["소고기"].amt)}</div></div>
    <div class="card"><small>🐔 닭고기 순구매 / 금액</small><strong>${fmtKg(meatStats["닭고기"].kg)} KG</strong><div style="font-size:12px;color:#1e40af;margin-top:2px;">₱ ${fmt(meatStats["닭고기"].amt)}</div></div>
    <div class="card"><small>📦 전체 합계 순구매 / 금액</small><strong>${fmtKg(meatStats["돼지고기"].kg + meatStats["소고기"].kg + meatStats["닭고기"].kg)} KG</strong><div style="font-size:12px;color:#1e40af;margin-top:2px;">₱ ${fmt(meatStats["돼지고기"].amt + meatStats["소고기"].amt + meatStats["닭고기"].amt)}</div></div>
  `;

  const totSaleAmt = lastReportRows.reduce((a, b) => a + b.sale_amt, 0);
  const totProfit = lastReportRows.reduce((a, b) => a + b.profit, 0);
  const totBuyKg = lastReportRows.reduce((a, b) => a + b.buy_kg, 0);
  const totLossKg = lastReportRows.reduce((a, b) => a + b.total_loss_kg, 0);
  const avgProfitRate = totSaleAmt > 0 ? (totProfit / totSaleAmt * 100) : 0;
  const avgLossRate = totBuyKg > 0 ? (totLossKg / totBuyKg * 100) : 0;

  document.getElementById('report-kpi-cards').innerHTML = `
    <div class="card"><small>조회 기간 총 매출액</small><strong>₱ ${fmt(totSaleAmt)}</strong></div>
    <div class="card"><small>조회 기간 추정 순익</small><strong>₱ ${fmt(totProfit)}</strong></div>
    <div class="card"><small>평균 수익률 vs 실로스율</small><strong>${avgProfitRate.toFixed(1)}% / ${avgLossRate.toFixed(1)}%</strong></div>
    <div class="card"><small>순수익률 격차 (수익률-로스율)</small><strong style="color:${(avgProfitRate-avgLossRate)>=0?'#15803d':'#dc2626'}">${(avgProfitRate - avgLossRate).toFixed(1)}%p</strong></div>
  `;

  renderReportTable();
  if (selectedReportProdId) {
    renderReportDetail(selectedReportProdId);
  }
}

function renderReportTable() {
  document.getElementById('report-body').innerHTML = lastReportRows.map(r => {
    const gap = r.net_margin_vs_loss;
    const gapBadge = gap >= 15
      ? `<span class="badge ok">양호 (+${gap}%p)</span>`
      : (gap >= 0 ? `<span class="badge carry">주의 (+${gap}%p)</span>` : `<span class="badge low">로스초과 (${gap}%p)</span>`);
    const minKg = 7.0;
    const isLow = r.total_stock_kg <= minKg;
    const isNegative = r.total_stock_kg < 0;
    const isSel = String(selectedReportProdId) === String(r.id);

    return `<tr class="clickable-row ${isSel ? 'selected-row' : (isNegative ? 'zero-kg' : (isLow ? 'low-stock' : ''))}" onclick="selectReportProduct('${r.id}')">
      <td>${r.category}</td>
      <td><b>${r.name}</b></td>
      <td>₱ ${fmt(r.last_buy_price)}</td><td>₱ ${fmt(r.adjusted_price)}</td><td>₱ ${fmt(r.sale_per_kg)}</td>
      <td><b>${fmtKg(r.carryover_kg)} kg</b></td><td>${fmtKg(r.buy_kg)}</td><td>₱ ${fmt(r.buy_amt)}</td>
      <td><b>${r.sale_qty}팩</b> / ${fmtKg(r.sale_kg)}kg</td><td>₱ ${fmt(r.sale_amt)}</td>
      <td><b>${fmtKg(r.slab_stock_kg)} kg</b></td>
      <td><b>${fmtKg(r.pack_stock_kg)} kg</b> (${r.pack_count}팩)</td>
      <td><b>${fmtKg(r.total_stock_kg)} kg</b> <span class="badge ${isLow ? 'low' : 'ok'}">${isLow ? '부족' : '정상'}</span></td>
      <td>${fmtKg(r.expected_loss_kg)}</td>
      <td>${fmtKg(r.trim_kg)}</td>
      <td>${fmtKg(r.waste_kg)}</td>
      <td><b>${fmtKg(r.total_loss_kg)}</b></td><td><b>${fmtKg(r.actual_loss_rate)}%</b></td><td>₱ ${fmt(r.loss_amt)}</td>
      <td><b>${fmtKg(r.profit_rate)}%</b></td>
      <td>${fmtKg(r.profit_rate)}% vs ${fmtKg(r.actual_loss_rate)}% ${gapBadge}</td>
    </tr>`;
  }).join('');
}

function selectReportProduct(pid) {
  selectedReportProdId = pid ? String(pid) : '';
  document.getElementById('rep-prod-select').value = selectedReportProdId;
  renderReportTable();
  if (!selectedReportProdId) {
    closeReportDetail();
    return;
  }
  renderReportDetail(selectedReportProdId);
}

function renderReportDetail(pid) {
  const item = lastReportRows.find(r => String(r.id) === String(pid));
  if (!item) {
    closeReportDetail();
    return;
  }
  const panel = document.getElementById('report-detail-panel');
  panel.style.display = 'block';
  const minKg = 7.0;
  const isLow = item.total_stock_kg <= minKg;

  document.getElementById('report-detail-title').textContent =
    `[${item.category}] ${item.name} — 슬랍·팩 재고 및 트림·폐기·실로스 상세 내역 (${item.detail_logs.length}건)`;

  document.getElementById('report-detail-cards').innerHTML = `
    <div class="card"><small>현재 슬랍 재고</small><strong>${fmtKg(item.slab_stock_kg)} KG</strong></div>
    <div class="card"><small>현재 팩 재고 (${item.pack_count}팩)</small><strong>${fmtKg(item.pack_stock_kg)} KG</strong></div>
    <div class="card"><small>총 현재고 / 안전재고(7.0kg)</small><strong style="color:${isLow ? '#dc2626' : '#15803d'}">${fmtKg(item.total_stock_kg)} KG (${isLow ? '부족' : '정상'})</strong></div>
    <div class="card"><small>트림 / 폐기 로스</small><strong>${fmtKg(item.trim_kg)} / ${fmtKg(item.waste_kg)} KG</strong></div>
    <div class="card"><small>기간 실로스 합계 (실로스율)</small><strong style="color:#dc2626">${fmtKg(item.total_loss_kg)} KG (${fmtKg(item.actual_loss_rate)}%)</strong></div>
  `;

  const tbody = document.getElementById('report-detail-body');
  if (!item.detail_logs.length) {
    tbody.innerHTML = `<tr><td colspan="10" style="text-align:center;color:#64748b;padding:16px;">선택한 조회 기간 내에 등록된 입출고·트림·폐기·실로스 내역이 없습니다.</td></tr>`;
  } else {
    tbody.innerHTML = item.detail_logs.map(log => {
      const hasLoss = log.total_loss_kg > 0 || log.trim_kg > 0 || log.waste_kg > 0;
      return `<tr class="clickable-row ${hasLoss ? 'zero-kg' : ''}" onclick="jumpToEditFromSummary(${log.id}, '${log.type}')">
        <td>${log.date}</td>
        <td><b>${log.type_label}</b></td>
        <td>${log.origin}</td>
        <td>${log.qty} 팩</td>
        <td>${fmtKg(log.slab_kg_delta)} KG</td>
        <td>${fmtKg(log.pack_kg_delta)} KG</td>
        <td><b>${fmtKg(log.trim_kg)} KG</b></td>
        <td><b>${fmtKg(log.waste_kg)} KG</b></td>
        <td><b>${fmtKg(log.total_loss_kg)} KG</b></td>
        <td>${log.note} <span style="color:#2563eb;font-size:11px;font-weight:bold;">[수정하기 ➔]</span></td>
      </tr>`;
    }).join('');
  }
  panel.scrollIntoView({behavior: 'smooth', block: 'nearest'});
}

function closeReportDetail() {
  selectedReportProdId = '';
  document.getElementById('rep-prod-select').value = '';
  document.getElementById('report-detail-panel').style.display = 'none';
  renderReportTable();
}

function exportExcel(mode) {
  let start, end, meat = '전체';
  if (mode === 'report') {
    start = document.getElementById('rep-start').value;
    end = document.getElementById('rep-end').value;
    meat = document.getElementById('rep-meat').value;
  } else {
    const base = document.getElementById('dash-target-date').value || getLocalToday();
    const ym = base.slice(0, 7);
    const [y, m] = ym.split('-').map(Number);
    const lastDay = String(new Date(y, m, 0).getDate()).padStart(2, '0');
    start = `${ym}-01`;
    end = `${ym}-${lastDay}`;
  }
  window.location.href = `/api/export/excel?start=${start}&end=${end}&meat=${encodeURIComponent(meat)}`;
  toast('엑셀(.xlsx) 보고서 파일 다운로드를 시작합니다.');
}

function exportBackupJson() {
  window.location.href = '/api/backup/export';
  toast('전체 데이터 백업 JSON 파일 다운로드를 시작합니다.');
}

async function importBackupJson(event) {
  const file = event.target.files[0];
  if (!file) return;
  if (!confirm('백업 JSON 파일로 데이터를 복원하시겠습니까? 기존 데이터가 백업 파일 내용으로 덮어씌워집니다.')) return;
  const fd = new FormData();
  fd.append('file', file);
  const res = await fetch('/api/backup/import', {method: 'POST', body: fd});
  const data = await res.json();
  if (!data.ok) return alert(data.error);
  toast('백업 데이터가 성공적으로 복원되었습니다.');
  await loadState();
}

async function deleteMovement(movId) {
  if (!confirm('이 작업 내역을 삭제하시겠습니까? 연동된 재고가 원복됩니다.')) return;
  const res = await fetch('/api/movements/delete', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({id: movId})});
  const data = await res.json();
  if (!data.ok) return alert(data.error);
  toast('작업 내역이 삭제되고 재고가 원복되었습니다.');
  await loadState();
}

async function deleteSnapshotItem(snapId) {
  if (!confirm('이 복구 스냅샷(백업 이력)을 삭제하시겠습니까?')) return;
  const res = await fetch('/api/snapshots/delete', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({snapshot_id: snapId})});
  const data = await res.json();
  if (!data.ok) return alert(data.error);
  toast('스냅샷 이력이 삭제되었습니다.');
  await loadState();
}

function renderHistory() {
  document.getElementById('snapshot-body').innerHTML = STATE.snapshots.map(s => `
    <tr>
      <td>${s.created_at}</td><td>${s.action_label}</td>
      <td><button class="btn undo" onclick="undoLast(${s.id})">이 시점으로 복구</button></td>
      <td><button class="btn warn" onclick="deleteSnapshotItem(${s.id})">삭제</button></td>
    </tr>
  `).join('');

  const prodMap = Object.fromEntries(STATE.products.map(p => [p.id, p.name]));
  const typeLabel = {
    "product_receiving": "상품입고", "carryover_inbound": "전월이월(상품)",
    "slab_inbound": "슬랍입고", "slab_carryover": "전월이월(슬랍)",
    "slab_production": "생산반영", "trim": "트림", "waste": "폐기", "sale": "판매차감"
  };
  document.getElementById('history-body').innerHTML = STATE.movements.map(m => `
    <tr class="clickable-row" onclick="jumpToEditFromSummary(${m.id}, '${m.type}')">
      <td>${m.date}</td><td><span class="badge ok">${typeLabel[m.type] || m.type}</span></td><td>${prodMap[m.product_id] || '-'}</td>
      <td>${m.qty}</td><td>${fmtKg(m.kg_delta)}</td><td>₱ ${fmt(m.amount)}</td><td>₱ ${fmt(m.price_per_kg)}</td><td>${m.note} <span style="color:#2563eb;font-size:11px;font-weight:bold;">[수정하기 ➔]</span></td>
      <td onclick="event.stopPropagation();"><button class="btn warn" onclick="deleteMovement(${m.id})">삭제</button></td>
    </tr>
  `).join('');
}

async function undoLast(snapId = null) {
  if (!confirm('선택한 이전 단계 상태로 데이터를 복구하시겠습니까?')) return;
  const res = await fetch('/api/undo', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify({snapshot_id: snapId})});
  const data = await res.json();
  if (!data.ok) return alert(data.error);
  toast('복구 완료: ' + data.label);
  await loadState();
}

window.onload = () => {
  const t = getLocalToday();
  ['dash-target-date', 'rec-date', 'slab-date', 'prod-run-date', 'trim-date', 'waste-date', 'sales-cal-date', 'rep-end'].forEach(id => {
    const el = document.getElementById(id);
    if (el) el.value = t;
  });
  document.getElementById('rep-start').value = t.slice(0, 8) + '01';
  document.getElementById('sales-cal-month').value = t.slice(0, 7);
  document.getElementById('prod-cal-month').value = t.slice(0, 7);
  document.getElementById('rec-cal-month').value = t.slice(0, 7);
  document.getElementById('trim-cal-month').value = t.slice(0, 7);
  document.getElementById('waste-cal-month').value = t.slice(0, 7);
  loadState();
};
</script>
</body>
</html>
"""


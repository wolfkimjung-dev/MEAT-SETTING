@app.route("/api/movements/delete", methods=["POST"])
def api_movement_delete():
    d = request.json or {}
    mid = d.get("id")
    conn = get_db()
    m = conn.execute("SELECT * FROM movements WHERE id=?", (mid,)).fetchone()
    if not m:
        conn.close()
        return jsonify({"ok": False, "error": "해당 작업 내역을 찾을 수 없습니다."})

    save_snapshot(conn, f"작업내역 삭제 및 원복: #{mid} ({m['type']})")
    pid = m["product_id"]
    sid = m["slab_id"]

    if sid and m["type"] in ("slab_inbound", "slab_carryover"):
        slab = conn.execute("SELECT * FROM slabs WHERE id=?", (sid,)).fetchone()
        if slab:
            t_pid = slab["product_id"]
            if not t_pid:
                mp = resolve_slab_product(conn, None, slab["meat_type"], slab["cut"])
                if mp: t_pid = mp["id"]
            if t_pid and slab["remaining_kg"] != 0:
                conn.execute("UPDATE products SET slab_stock_kg = ROUND(slab_stock_kg - ?, 3) WHERE id=?",
                             (slab["remaining_kg"], t_pid))
            conn.execute("DELETE FROM slabs WHERE id=?", (sid,))

    if sid and m["type"] in ("slab_production", "trim"):
        slab = conn.execute("SELECT * FROM slabs WHERE id=?", (sid,)).fetchone()
        if slab:
            restore_kg = abs(m["slab_kg_delta"] or 0)
            new_rem = round(slab["remaining_kg"] + restore_kg, 3)
            conn.execute("UPDATE slabs SET remaining_kg=?, status='open' WHERE id=?", (new_rem, sid))
            s_pid = slab.get("product_id")
            if not s_pid:
                mp = resolve_slab_product(conn, None, slab["meat_type"], slab["cut"])
                if mp: s_pid = mp["id"]
            if s_pid:
                conn.execute("UPDATE products SET slab_stock_kg = ROUND(slab_stock_kg + ?, 3) WHERE id=?",
                             (restore_kg, s_pid))

    if pid and m["type"] in ("sale", "waste", "product_receiving", "carryover_inbound", "slab_production", "slab_carryover"):
        prod = conn.execute("SELECT * FROM products WHERE id=?", (pid,)).fetchone()
        if prod:
            if m["type"] == "sale":
                new_pack_kg = round(prod["pack_stock_kg"] - (m["pack_kg_delta"] or m["kg_delta"] or 0), 3)
                new_slab_kg = round(prod["slab_stock_kg"] - (m["slab_kg_delta"] or 0), 3)
                new_cnt = prod["pack_count"] + (m["qty"] or 0)
                conn.execute("UPDATE products SET pack_stock_kg=?, slab_stock_kg=?, pack_count=? WHERE id=?",
                             (new_pack_kg, new_slab_kg, new_cnt, pid))
            elif m["type"] == "waste":
                new_pack_kg = round(prod["pack_stock_kg"] + abs(m["pack_kg_delta"] or 0), 3)
                new_slab_kg = round(prod["slab_stock_kg"] + abs(m["slab_kg_delta"] or 0), 3)
                new_cnt = prod["pack_count"] + abs(m["pack_delta"] or 0)
                conn.execute("UPDATE products SET pack_stock_kg=?, slab_stock_kg=?, pack_count=? WHERE id=?",
                             (new_pack_kg, new_slab_kg, new_cnt, pid))
            elif m["type"] == "slab_production":
                new_pack_kg = round(prod["pack_stock_kg"] - abs(m["pack_kg_delta"] or m["kg_delta"] or 0), 3)
                new_cnt = prod["pack_count"] - abs(m["pack_delta"] or m["qty"] or 0)
                conn.execute("UPDATE products SET pack_stock_kg=?, pack_count=? WHERE id=?",
                             (new_pack_kg, new_cnt, pid))
            elif m["type"] in ("product_receiving", "carryover_inbound", "slab_carryover", "slab_inbound"):
                new_pack_kg = round(prod["pack_stock_kg"] - abs(m["pack_kg_delta"] or 0), 3)
                new_slab_kg = round(prod["slab_stock_kg"] - abs(m["slab_kg_delta"] or 0), 3)
                new_cnt = prod["pack_count"] - abs(m["pack_delta"] or 0)
                conn.execute("UPDATE products SET pack_stock_kg=?, slab_stock_kg=?, pack_count=? WHERE id=?",
                             (new_pack_kg, new_slab_kg, new_cnt, pid))

    conn.execute("DELETE FROM movements WHERE id=?", (mid,))
    conn.commit()
    conn.close()
    return jsonify({"ok": True})


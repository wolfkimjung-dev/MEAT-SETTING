@app.route("/api/undo", methods=["POST"])
def api_undo():
    data = request.json or {}
    snap_id = data.get("snapshot_id")
    conn = get_db()
    if snap_id:
        row = conn.execute("SELECT * FROM snapshots WHERE id=?", (snap_id,)).fetchone()
    else:
        row = conn.execute("SELECT * FROM snapshots ORDER BY id DESC LIMIT 1").fetchone()
    if not row:
        conn.close()
        return jsonify({"ok": False, "error": "복구할 이전 단계가 없습니다."})

    payload = json.loads(row["payload"])
    for tbl in ["products", "slabs", "movements", "sales_imports", "settings"]:
        conn.execute(f"DELETE FROM {tbl}")
        for r in payload.get(tbl, []):
            cols = list(r.keys())
            conn.execute(f"INSERT INTO {tbl} ({','.join(cols)}) VALUES ({','.join(['?']*len(cols))})", [r[c] for c in cols])

    conn.execute("DELETE FROM snapshots WHERE id >= ?", (row["id"],))
    conn.commit()
    conn.close()
    return jsonify({"ok": True, "label": row["action_label"]})

@app.route("/api/products/save", methods=["POST"])
def api_product_save():
    d = request.json or {}
    conn = get_db()
    settings = {r["k"]: r["v"] for r in conn.execute("SELECT * FROM settings").fetchall()}
    fixed_loss = num(settings.get("fixed_loss_rate", 20))
    margin = num(settings.get("margin_rate", 35))

    pid = d.get("id")
    name = str(d.get("name", "")).strip()
    if not name:
        conn.close()
        return jsonify({"ok": False, "error": "상품명을 입력하세요."})

    buy_100g = num(d.get("buy_price_100g"))
    buy_kg, adj_price, auto_sale = calc_prices(buy_100g, fixed_loss, margin)
    if num(d.get("adjusted_price")) > 0:
        adj_price = num(d.get("adjusted_price"))
    sale_per_kg = num(d.get("sale_per_kg")) if num(d.get("sale_per_kg")) > 0 else auto_sale

    slab_kg = num(d.get("slab_stock_kg"))
    pack_kg = num(d.get("pack_stock_kg"))
    pack_cnt = int(num(d.get("pack_count")))
    min_stock_kg = 7.0
    barcode = str(d.get("barcode", "")).strip()
    category = str(d.get("category", "돼지고기")).strip()
    cut = str(d.get("cut", "")).strip()
    stock_kind = str(d.get("stock_kind", "pack")).strip()

    save_snapshot(conn, f"상품 {'수정' if pid else '등록'}: {name}")
    if pid:
        conn.execute("""
            UPDATE products SET name=?, name_key=?, barcode=?, category=?, cut=?, stock_kind=?,
            buy_price_100g=?, buy_price_kg=?, adjusted_price=?, sale_per_kg=?,
            slab_stock_kg=?, pack_stock_kg=?, pack_count=?, min_stock_kg=?
            WHERE id=?
        """, (name, normalize_key(name), barcode, category, cut, stock_kind,
              buy_100g, buy_kg, adj_price, sale_per_kg, slab_kg, pack_kg, pack_cnt, min_stock_kg, pid))
    else:
        conn.execute("""
            INSERT INTO products (name, name_key, barcode, category, cut, stock_kind,
            buy_price_100g, buy_price_kg, adjusted_price, sale_per_kg, slab_stock_kg, pack_stock_kg, pack_count, min_stock_kg)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (name, normalize_key(name), barcode, category, cut, stock_kind,
              buy_100g, buy_kg, adj_price, sale_per_kg, slab_kg, pack_kg, pack_cnt, min_stock_kg))
    conn.commit()
    conn.close()
    return jsonify({"ok": True})

@app.route("/api/products/receive", methods=["POST"])
def api_product_receive():
    d = request.json or {}
    conn = get_db()
    settings = {r["k"]: r["v"] for r in conn.execute("SELECT * FROM settings").fetchall()}
    fixed_loss = num(settings.get("fixed_loss_rate", 20))
    margin = num(settings.get("margin_rate", 35))

    pid = int(num(d.get("product_id")))
    rec_date = str(d.get("date") or date.today().isoformat())
    target_type = str(d.get("target_type") or "pack")
    in_kg = num(d.get("kg"))
    in_packs = int(num(d.get("packs")))
    loss_kg = num(d.get("loss_kg"))
    buy_100g = num(d.get("buy_price_100g"))
    is_carryover = 1 if d.get("is_carryover") else 0

    prod = conn.execute("SELECT * FROM products WHERE id=?", (pid,)).fetchone()
    if not prod or (in_kg <= 0 and loss_kg <= 0):
        conn.close()
        return jsonify({"ok": False, "error": "상품과 입고 중량(또는 로스)을 입력하세요."})

    save_snapshot(conn, f"상품 {'전월이월' if is_carryover else '입고'}: {prod['name']} ({in_kg}kg)")
    if buy_100g > 0:
        buy_kg, adj_price, sale_price = calc_prices(buy_100g, fixed_loss, margin)
    else:
        buy_100g = prod["buy_price_100g"]
        buy_kg = prod["buy_price_kg"]
        adj_price = prod["adjusted_price"]
        sale_price = prod["sale_per_kg"]

    net_kg = round(in_kg - loss_kg, 3)
    new_slab_kg = round(prod["slab_stock_kg"] + (net_kg if target_type == "slab" else 0.0), 3)
    new_pack_kg = round(prod["pack_stock_kg"] + (net_kg if target_type == "pack" else 0.0), 3)
    new_pack_cnt = prod["pack_count"] + (in_packs if target_type == "pack" else 0)

    conn.execute("""
        UPDATE products SET buy_price_100g=?, buy_price_kg=?, adjusted_price=?, sale_per_kg=?,
        slab_stock_kg=?, pack_stock_kg=?, pack_count=? WHERE id=?
    """, (buy_100g, buy_kg, adj_price, sale_price, new_slab_kg, new_pack_kg, new_pack_cnt, pid))

    mov_type = "carryover_inbound" if is_carryover else "product_receiving"
    note_prefix = "전월이월 재고등록" if is_carryover else "상품 입고"
    total_amount = round(in_kg * buy_kg, 2)
    conn.execute("""
        INSERT INTO movements (date, created_at, type, product_id, meat_type, qty, kg_delta,
        slab_kg_delta, pack_kg_delta, pack_delta, loss_kg, unit_price, amount, price_per_kg, note)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (rec_date, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), mov_type, pid, prod["category"],
          in_packs, net_kg,
          net_kg if target_type == "slab" else 0.0,
          net_kg if target_type == "pack" else 0.0,
          in_packs if target_type == "pack" else 0,
          loss_kg, buy_kg, total_amount, buy_kg,
          f"{note_prefix} (총 {in_kg}kg / 로스 {loss_kg}kg / 순반영 {net_kg}kg)"))
    conn.commit()
    conn.close()
    return jsonify({"ok": True})

@app.route("/api/products/receive/update", methods=["POST"])
def api_product_receive_update():
    d = request.json or {}
    mid = int(num(d.get("id")))
    rec_date = str(d.get("date") or date.today().isoformat())
    new_pid = int(num(d.get("product_id")))
    target_type = str(d.get("target_type") or "pack")
    in_kg = num(d.get("kg"))
    in_packs = int(num(d.get("packs")))
    loss_kg = num(d.get("loss_kg"))
    buy_100g = num(d.get("buy_price_100g"))
    is_carryover = 1 if d.get("is_carryover") else 0

    conn = get_db()
    m = conn.execute("SELECT * FROM movements WHERE id=? AND type IN ('product_receiving', 'carryover_inbound')", (mid,)).fetchone()
    if not m:
        conn.close()
        return jsonify({"ok": False, "error": "수정할 상품 입고 이력을 찾을 수 없습니다."})

    new_prod = conn.execute("SELECT * FROM products WHERE id=?", (new_pid,)).fetchone()
    if not new_prod or (in_kg <= 0 and loss_kg <= 0):
        conn.close()
        return jsonify({"ok": False, "error": "상품과 입고 중량(또는 로스)을 입력하세요."})

    settings = {r["k"]: r["v"] for r in conn.execute("SELECT * FROM settings").fetchall()}
    fixed_loss = num(settings.get("fixed_loss_rate", 20))
    margin = num(settings.get("margin_rate", 35))

    save_snapshot(conn, f"상품입고 이력 수정: #{mid}")

    old_pid = m["product_id"]
    if old_pid:
        old_prod = conn.execute("SELECT * FROM products WHERE id=?", (old_pid,)).fetchone()
        if old_prod:
            r_pack_kg = round(old_prod["pack_stock_kg"] - abs(m["pack_kg_delta"] or 0), 3)
            r_slab_kg = round(old_prod["slab_stock_kg"] - abs(m["slab_kg_delta"] or 0), 3)
            r_cnt = old_prod["pack_count"] - abs(m["pack_delta"] or 0)
            conn.execute(
                "UPDATE products SET pack_stock_kg=?, slab_stock_kg=?, pack_count=? WHERE id=?",
                (r_pack_kg, r_slab_kg, r_cnt, old_pid)
            )

    fresh_prod = conn.execute("SELECT * FROM products WHERE id=?", (new_pid,)).fetchone()
    if buy_100g > 0:
        buy_kg, adj_price, sale_price = calc_prices(buy_100g, fixed_loss, margin)
    else:
        buy_100g = fresh_prod["buy_price_100g"]
        buy_kg = fresh_prod["buy_price_kg"]
        adj_price = fresh_prod["adjusted_price"]
        sale_price = fresh_prod["sale_per_kg"]

    net_kg = round(in_kg - loss_kg, 3)
    u_slab_kg = round(fresh_prod["slab_stock_kg"] + (net_kg if target_type == "slab" else 0.0), 3)
    u_pack_kg = round(fresh_prod["pack_stock_kg"] + (net_kg if target_type == "pack" else 0.0), 3)
    u_pack_cnt = fresh_prod["pack_count"] + (in_packs if target_type == "pack" else 0)

    conn.execute("""
        UPDATE products SET buy_price_100g=?, buy_price_kg=?, adjusted_price=?, sale_per_kg=?,
        slab_stock_kg=?, pack_stock_kg=?, pack_count=? WHERE id=?
    """, (buy_100g, buy_kg, adj_price, sale_price, u_slab_kg, u_pack_kg, u_pack_cnt, new_pid))

    mov_type = "carryover_inbound" if is_carryover else "product_receiving"
    note_prefix = "전월이월 재고등록(수정)" if is_carryover else "상품 입고(수정)"
    total_amount = round(in_kg * buy_kg, 2)
    conn.execute("""
        UPDATE movements SET date=?, type=?, product_id=?, meat_type=?, qty=?, kg_delta=?,
        slab_kg_delta=?, pack_kg_delta=?, pack_delta=?, loss_kg=?, unit_price=?, amount=?, price_per_kg=?, note=?
        WHERE id=?
    """, (rec_date, mov_type, new_pid, fresh_prod["category"], in_packs, net_kg,
          net_kg if target_type == "slab" else 0.0,
          net_kg if target_type == "pack" else 0.0,
          in_packs if target_type == "pack" else 0,
          loss_kg, buy_kg, total_amount, buy_kg,
          f"{note_prefix} (총 {in_kg}kg / 로스 {loss_kg}kg / 순반영 {net_kg}kg)", mid))

    conn.commit()
    conn.close()
    return jsonify({"ok": True})


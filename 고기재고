<script>
let STATE = null;
let prodPartFilter = '전체';
let selectedCalDate = '';
let selectedProdCalDate = '';
let selectedRecCalDate = '';
let selectedTrimCalDate = '';
let selectedWasteCalDate = '';
let salesPreviewData = null;
let lastReportRows = [];
let selectedReportProdId = '';

function getLocalToday() {
  const now = new Date();
  const y = now.getFullYear();
  const m = String(now.getMonth() + 1).padStart(2, '0');
  const d = String(now.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}

function getPrevMonthLastDay() {
  const now = new Date();
  const lastDayPrevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
  const y = lastDayPrevMonth.getFullYear();
  const m = String(lastDayPrevMonth.getMonth() + 1).padStart(2, '0');
  const d = String(lastDayPrevMonth.getDate()).padStart(2, '0');
  return `${y}-${m}-${d}`;
}

function fmt(n) { return Number(n || 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2}); }
function fmtKg(n) { return Number(n || 0).toFixed(3); }
function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.style.display = 'block';
  setTimeout(() => el.style.display = 'none', 3200);
}

function showTab(id, btn) {
  document.querySelectorAll('main > section').forEach(s => s.style.display = 'none');
  document.getElementById('tab-' + id).style.display = 'block';
  document.querySelectorAll('aside .nav').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  document.getElementById('page-title').textContent = btn ? btn.textContent : id;
  loadState().then(() => {
    if (id === 'report') loadReport();
  });
}

async function loadState() {
  const res = await fetch('/api/state?_t=' + Date.now(), {cache: 'no-store'});
  STATE = await res.json();
  document.getElementById('db-info').textContent = `DB 파일: ${STATE.db_path} (동기화: ${STATE.server_ts})`;
  document.getElementById('set-loss-rate').value = STATE.settings.fixed_loss_rate || 20;
  document.getElementById('set-margin-rate').value = STATE.settings.margin_rate || 35;

  renderDashboard();
  renderProducts();
  renderReceivingCalendar();
  renderReceivingTable();
  renderSlabSection();
  renderSalesCalendar();
  renderSalesHistory();
  renderHistory();
}

async function forceRefreshAll() {
  await loadState();
  if (document.getElementById('tab-report').style.display !== 'none') {
    await loadReport();
  }
  toast('최신 데이터 및 전체 내역이 새로고침되었습니다.');
}

function renderDashboard() {
  const dashDateEl = document.getElementById('dash-target-date');
  if (!dashDateEl.value) dashDateEl.value = getLocalToday();
  const targetDateStr = dashDateEl.value;
  const monthStr = targetDateStr.slice(0, 7);
  document.getElementById('month-label').textContent = monthStr;

  const todayMovs = STATE.movements.filter(m => (m.date || '').startsWith(targetDateStr));
  const monthMovs = STATE.movements.filter(m => (m.date || '').startsWith(monthStr));

  const tBuy = todayMovs.filter(m => m.type === 'product_receiving' || m.type === 'slab_inbound').reduce((a, b) => a + (b.kg_delta || 0), 0);
  const tSaleMovs = todayMovs.filter(m => m.type === 'sale');
  const tSaleQty = tSaleMovs.reduce((a, b) => a + (b.qty || 0), 0);
  const tSaleKg = tSaleMovs.reduce((a, b) => a + (-b.kg_delta || 0), 0);
  const tLoss = todayMovs.reduce((a, b) => a + (b.trim_kg || 0) + (b.waste_kg || 0), 0);
  const tAmt = tSaleMovs.reduce((a, b) => a + (b.amount || 0), 0);

  document.getElementById('today-cards').innerHTML = `
    <div class="card" onclick="openSummaryDetailModal('today_inbound', '${targetDateStr}')"><small>${targetDateStr} 순수 입고 KG (클릭시 상세)</small><strong>${fmtKg(tBuy)} KG</strong></div>
    <div class="card" onclick="openSummaryDetailModal('today_sale_qty', '${targetDateStr}')"><small>${targetDateStr} 판매 수량 (클릭시 상세)</small><strong>${tSaleQty.toLocaleString()} 팩</strong></div>
    <div class="card" onclick="openSummaryDetailModal('today_sale_kg', '${targetDateStr}')"><small>${targetDateStr} 판매 중량 (클릭시 상세)</small><strong>${fmtKg(tSaleKg)} KG</strong></div>
    <div class="card" onclick="openSummaryDetailModal('today_loss', '${targetDateStr}')"><small>${targetDateStr} 트림·폐기 로스 (클릭시 상세)</small><strong>${fmtKg(tLoss)} KG</strong></div>
    <div class="card" onclick="openSummaryDetailModal('today_sale_amt', '${targetDateStr}')"><small>${targetDateStr} 판매액 (클릭시 상세)</small><strong>₱ ${fmt(tAmt)}</strong></div>
  `;

  const mBuy = monthMovs.filter(m => m.type === 'product_receiving' || m.type === 'slab_inbound').reduce((a, b) => a + (b.kg_delta || 0), 0);
  const mSaleMovs = monthMovs.filter(m => m.type === 'sale');
  const mSaleQty = mSaleMovs.reduce((a, b) => a + (b.qty || 0), 0);
  const mSaleKg = mSaleMovs.reduce((a, b) => a + (-b.kg_delta || 0), 0);
  const mLoss = monthMovs.reduce((a, b) => a + (b.trim_kg || 0) + (b.waste_kg || 0), 0);
  const mAmt = mSaleMovs.reduce((a, b) => a + (b.amount || 0), 0);

  document.getElementById('month-cards').innerHTML = `
    <div class="card" onclick="openSummaryDetailModal('month_inbound', '${monthStr}')"><small>${monthStr} 당월 순구매 KG (클릭시 상세)</small><strong>${fmtKg(mBuy)} KG</strong></div>
    <div class="card" onclick="openSummaryDetailModal('month_sale_qty', '${monthStr}')"><small>${monthStr} 총 판매 수량 (클릭시 상세)</small><strong>${mSaleQty.toLocaleString()} 팩</strong></div>
    <div class="card" onclick="openSummaryDetailModal('month_sale_kg', '${monthStr}')"><small>${monthStr} 총 판매 중량 (클릭시 상세)</small><strong>${fmtKg(mSaleKg)} KG</strong></div>
    <div class="card" onclick="openSummaryDetailModal('month_loss', '${monthStr}')"><small>${monthStr} 총 트림·폐기 (클릭시 상세)</small><strong>${fmtKg(mLoss)} KG</strong></div>
    <div class="card" onclick="openSummaryDetailModal('month_sale_amt', '${monthStr}')"><small>${monthStr} 총 판매액 (클릭시 상세)</small><strong>₱ ${fmt(mAmt)}</strong></div>
  `;

  const monthSaleByProd = {};
  mSaleMovs.forEach(m => {
    if (!m.product_id) return;
    if (!monthSaleByProd[m.product_id]) monthSaleByProd[m.product_id] = {qty: 0, kg: 0};
    monthSaleByProd[m.product_id].qty += (m.qty || 0);
    monthSaleByProd[m.product_id].kg += (-m.kg_delta || 0);
  });

  const searchQ = (document.getElementById('dash-search').value || '').toLowerCase();
  const partFilter = document.getElementById('dash-part-filter').value;
  const lowOnly = document.getElementById('dash-low-only').checked;

  let lowCount = 0;
  STATE.products.forEach(p => {
    if ((p.slab_stock_kg + p.pack_stock_kg) <= 7.0) lowCount++;
  });
  document.getElementById('low-stock-alert').textContent = lowCount > 0 ? `⚠ 안전재고(7kg) 이하 품목: ${lowCount}개` : '✔ 전 품목 안전재고(7kg) 양호';

  const filtered = STATE.products.filter(p => {
    const tot = p.slab_stock_kg + p.pack_stock_kg;
    const isLow = tot <= 7.0;
    if (partFilter !== '전체' && p.category !== partFilter) return false;
    if (lowOnly && !isLow) return false;
    if (searchQ && !p.name.toLowerCase().includes(searchQ) && !p.cut.toLowerCase().includes(searchQ)) return false;
    return true;
  });

  const tbody = document.getElementById('dash-stock-body');
  tbody.innerHTML = filtered.map(p => {
    const tot = p.slab_stock_kg + p.pack_stock_kg;
    const minKg = 7.0;
    const isLow = tot <= minKg;
    const val = tot * p.sale_per_kg;
    const ms = monthSaleByProd[p.id] || {qty: 0, kg: 0};
    const isNegative = tot < 0;
    return `<tr class="${isNegative ? 'zero-kg' : (isLow ? 'low-stock' : '')}">
      <td>${p.category}</td><td>${p.cut}</td>
      <td><span class="clickable-product" onclick="openProductDetailModal(${p.id})"><b>${p.name}</b> 🔍이력</span></td>
      <td>${fmtKg(p.slab_stock_kg)}</td><td>${fmtKg(p.pack_stock_kg)}</td><td>${p.pack_count} 팩</td>
      <td><b>${fmtKg(tot)}</b></td>
      <td><span class="badge ${isLow ? 'low' : 'ok'}">${isLow ? '부족' : '정상'} (7.0kg)</span></td>
      <td><b>${ms.qty}팩</b> / ${fmtKg(ms.kg)}kg</td>
      <td>₱ ${fmt(p.sale_per_kg)}</td><td>₱ ${fmt(val)}</td>
    </tr>`;
  }).join('');
}

function openSummaryDetailModal(categoryKey, dateStr) {
  let matchedMovs = [];
  let titleStr = '';

  if (categoryKey.includes('inbound')) {
    const isMonth = categoryKey.startsWith('month');
    titleStr = `${isMonth ? dateStr + ' 월누적' : dateStr} 순수 입고(구매) 상세 내역`;
    matchedMovs = STATE.movements.filter(m => (m.type === 'product_receiving' || m.type === 'slab_inbound') && (isMonth ? (m.date || '').startsWith(dateStr) : (m.date || '').slice(0, 10) === dateStr));
  } else if (categoryKey.includes('sale')) {
    const isMonth = categoryKey.startsWith('month');
    titleStr = `${isMonth ? dateStr + ' 월누적' : dateStr} 판매 상세 내역`;
    matchedMovs = STATE.movements.filter(m => m.type === 'sale' && (isMonth ? (m.date || '').startsWith(dateStr) : (m.date || '').slice(0, 10) === dateStr));
  } else if (categoryKey.includes('loss')) {
    const isMonth = categoryKey.startsWith('month');
    titleStr = `${isMonth ? dateStr + ' 월누적' : dateStr} 트림·폐기 로스 상세 내역`;
    matchedMovs = STATE.movements.filter(m => (m.type === 'waste' || m.type === 'trim') && (isMonth ? (m.date || '').startsWith(dateStr) : (m.date || '').slice(0, 10) === dateStr));
  }

  document.getElementById('summary-modal-title').textContent = titleStr;
  const prodMap = Object.fromEntries(STATE.products.map(p => [p.id, p.name]));

  const tbody = document.getElementById('summary-modal-body');
  if (!matchedMovs.length) {
    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:#64748b;padding:20px;">해당 조건의 이력이 없습니다.</td></tr>`;
  } else {
    tbody.innerHTML = matchedMovs.map(m => {
      const pName = prodMap[m.product_id] || (m.slab_id ? `슬랍 #${m.slab_id}` : '-');
      const kgVal = m.kg_delta !== 0 ? m.kg_delta : (m.trim_kg || m.waste_kg || 0);
      return `<tr class="clickable-row" onclick="jumpToEditFromSummary(${m.id}, '${m.type}')">
        <td>${m.date}</td>
        <td><span class="badge ok">${m.type}</span></td>
        <td><b>${pName}</b></td>
        <td>${m.qty || 0} 팩</td>
        <td><b>${fmtKg(kgVal)} KG</b></td>
        <td>₱ ${fmt(m.amount || 0)}</td>
        <td>${m.note || ''}</td>
        <td><button class="btn primary" style="padding:3px 8px;font-size:11px;">수정/관리로 이동</button></td>
      </tr>`;
    }).join('');
  }
  document.getElementById('summary-detail-modal').style.display = 'flex';
}

function closeSummaryModal() {
  document.getElementById('summary-detail-modal').style.display = 'none';
}

function jumpToEditFromSummary(movId, movType) {
  closeSummaryModal();
  closeProductModal();
  closeSlabSummaryModal();
  const m = STATE.movements.find(x => x.id === movId);
  if (!m) return;

  if (m.type === 'product_receiving' || m.type === 'carryover_inbound') {
    showTab('products', document.querySelectorAll('aside .nav')[1]);
    editReceiveMovement(m);
  } else if (m.type === 'slab_inbound' || m.type === 'slab_carryover') {
    showTab('slabs', document.querySelectorAll('aside .nav')[2]);
    showSlabSubTab('inbound', document.querySelectorAll('#tab-slabs .subtabs button')[0]);
    const slab = STATE.slabs.find(s => s.id === m.slab_id);
    if (slab) editSlab(slab);
  } else if (m.type === 'slab_production') {
    showTab('slabs', document.querySelectorAll('aside .nav')[2]);
    showSlabSubTab('production', document.querySelectorAll('#tab-slabs .subtabs button')[1]);
    editProduction(m);
  } else if (m.type === 'trim') {
    showTab('slabs', document.querySelectorAll('aside .nav')[2]);
    showSlabSubTab('trim', document.querySelectorAll('#tab-slabs .subtabs button')[2]);
    editTrimMovement(m);
  } else if (m.type === 'waste') {
    showTab('slabs', document.querySelectorAll('aside .nav')[2]);
    showSlabSubTab('waste', document.querySelectorAll('#tab-slabs .subtabs button')[3]);
    editWasteMovement(m);
  } else if (m.type === 'sale') {
    showTab('sales', document.querySelectorAll('aside .nav')[3]);
    const matchedImport = STATE.sales_imports.find(si => m.note.includes(si.sheet_name) || si.deduct_date === m.date);
    if (matchedImport) openSalesDetail(matchedImport.id);
  } else {
    showTab('history', document.querySelectorAll('aside .nav')[5]);
  }
}

async function openProductDetailModal(pid) {
  const res = await fetch(`/api/products/history/${pid}?_t=${Date.now()}`, {cache: 'no-store'});
  const data = await res.json();
  if (!data.ok) return alert(data.error);

  const prod = data.product;
  const movs = data.movements;
  
  document.getElementById('modal-product-title').textContent = `[${prod.category}] ${prod.name} 상세 이력 및 판매 기록`;
  
  const totStock = prod.slab_stock_kg + prod.pack_stock_kg;
  document.getElementById('modal-product-summary').innerHTML = `
    <div class="card" style="padding:10px;"><small>총 재고</small><strong>${fmtKg(totStock)} KG</strong></div>
    <div class="card" style="padding:10px;"><small>팩 재고</small><strong>${fmtKg(prod.pack_stock_kg)} KG (${prod.pack_count}팩)</strong></div>
    <div class="card" style="padding:10px;"><small>슬랍 재고</small><strong>${fmtKg(prod.slab_stock_kg)} KG</strong></div>
    <div class="card" style="padding:10px;"><small>판매가</small><strong>₱ ${fmt(prod.sale_per_kg)}/kg</strong></div>
  `;

  const typeLabels = {
    "product_receiving": "상품입고", "carryover_inbound": "전월이월(상품)",
    "slab_inbound": "슬랍입고", "slab_carryover": "전월이월(슬랍)",
    "slab_production": "생산반영", "trim": "트림", "waste": "폐기", "sale": "판매차감"
  };

  const tbody = document.getElementById('modal-product-history-body');
  if (!movs.length) {
    tbody.innerHTML = `<tr><td colspan="7" style="text-align:center;color:#64748b;padding:20px;">등록된 입출고 및 판매 이력이 없습니다.</td></tr>`;
  } else {
    tbody.innerHTML = movs.map(m => {
      const isSale = m.type === 'sale';
      const isReceive = m.type.includes('receiving') || m.type.includes('inbound') || m.type.includes('carryover');
      const badgeCls = isSale ? 'badge ok' : (isReceive ? 'badge carry' : 'badge low');
      return `<tr class="clickable-row ${isSale ? 'done-row' : ''}" onclick="jumpToEditFromSummary(${m.id}, '${m.type}')">
        <td>${m.date} <br><small style="color:#64748b;">${m.created_at || ''}</small></td>
        <td><span class="${badgeCls}">${typeLabels[m.type] || m.type}</span></td>
        <td><b>${m.qty || 0} 팩</b></td>
        <td><b>${fmtKg(m.kg_delta || 0)} KG</b></td>
        <td>₱ ${fmt(m.unit_price || m.price_per_kg || 0)}</td>
        <td><b>₱ ${fmt(m.amount || 0)}</b></td>
        <td>${m.note || ''} <span style="color:#2563eb;font-size:11px;font-weight:bold;">[수정하기 ➔]</span></td>
      </tr>`;
    }).join('');
  }

  document.getElementById('product-modal').style.display = 'flex';
}

function closeProductModal() {
  document.getElementById('product-modal').style.display = 'none';
}

function openSlabSummaryModal(filterType) {
  let slabsList = STATE.slabs;
  let title = "전체 슬랍 원물 현황";

  if (filterType === 'total_kg') {
    title = "보유중인 전체 슬랍 상세 목록 (잔여 KG 기준)";
    slabsList = STATE.slabs.filter(s => s.remaining_kg > 0.0001);
  } else if (filterType === 'count') {
    title = "전체 등록 슬랍 개수 목록";
  } else if (filterType === 'loss') {
    title = "누적 트림·폐기 관련 슬랍 이력";
  } else if (filterType === 'trim') {
    title = "누적 트림 이력 대상 슬랍 목록";
  }

  document.getElementById('slab-summary-modal-title').textContent = title;
  const tbody = document.getElementById('slab-summary-modal-body');
  if (!slabsList.length) {
    tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;color:#64748b;padding:20px;">등록된 슬랍이 없습니다.</td></tr>`;
  } else {
    tbody.innerHTML = slabsList.map(s => {
      const isZero = s.remaining_kg <= 0.0001;
      return `<tr class="clickable-row ${isZero ? 'zero-kg' : ''}" onclick="closeSlabSummaryModal(); editSlab(${JSON.stringify(s)})">
        <td>${s.date} ${s.is_carryover ? '(이월)' : ''}</td>
        <td><b>${s.meat_type}</b></td>
        <td>${s.cut}</td>
        <td>#${s.slab_no || s.id}</td>
        <td>${fmtKg(s.kg)} KG</td>
        <td><b>${fmtKg(s.remaining_kg)} KG</b></td>
        <td>₱ ${fmt(s.buy_price_kg)}</td>
        <td><span class="badge ${isZero ? 'low' : 'ok'}">${isZero ? '소진' : '보유중'}</span></td>
      </tr>`;
    }).join('');
  }
  document.getElementById('slab-summary-modal').style.display = 'flex';
}

function closeSlabSummaryModal() {
  document.getElementById('slab-summary-modal').style.display = 'none';
}

function updateCatalogCuts() {
  const cat = document.getElementById('prod-cat').value;
  const cuts = Object.keys(STATE.catalog[cat] || {});
  document.getElementById('prod-cut').innerHTML = cuts.map(c => `<option>${c}</option>`).join('');
  updateCatalogNames();
}

function updateCatalogNames() {
  const cat = document.getElementById('prod-cat').value;
  const cut = document.getElementById('prod-cut').value;
  const names = (STATE.catalog[cat] || {})[cut] || [];
  document.getElementById('prod-preset').innerHTML = '<option value="">카탈로그 상품 선택</option>' + names.map(n => `<option>${n}</option>`).join('');
}

function updateReceiveProductOptions() {
  const meat = document.getElementById('rec-meat').value;
  const matched = STATE.products.filter(p => p.category === meat);
  document.getElementById('rec-prod').innerHTML = matched.map(p => `<option value="${p.id}">[${p.category}] ${p.name}</option>`).join('');
}

function previewCalcPrice() {
  const b100 = parseFloat(document.getElementById('prod-buy100').value) || 0;
  const loss = parseFloat(STATE.settings.fixed_loss_rate || 20);
  const margin = parseFloat(STATE.settings.margin_rate || 35);
  const bKg = b100 * 10;
  const adj = bKg / (1 - loss / 100);
  const sale = adj * (1 + margin / 100);
  document.getElementById('prod-adj').value = adj.toFixed(2);
  document.getElementById('prod-sale').value = sale.toFixed(2);
  document.getElementById('price-preview').textContent = `자동계산: KG당 매입가 ₱${fmt(bKg)} | 보정단가(로스 ${loss}% 반영) ₱${fmt(adj)} | 권장 판매가(마진 ${margin}%) ₱${fmt(sale)}`;
}

function renderProducts() {
  updateCatalogCuts();
  updateReceiveProductOptions();
  const tbody = document.getElementById('prod-table-body');
  tbody.innerHTML = STATE.products
    .filter(p => prodPartFilter === '전체' || p.category === prodPartFilter)
    .map(p => {
      const tot = p.slab_stock_kg + p.pack_stock_kg;
      const val = tot * p.sale_per_kg;
      const isNegative = tot < 0;
      return `<tr class="${isNegative ? 'zero-kg' : ''}">
        <td>${p.category}</td><td>${p.cut}</td>
        <td><span class="clickable-product" onclick="openProductDetailModal(${p.id})"><b>${p.name}</b> 🔍입고히스토리</span></td>
        <td>₱${fmt(p.buy_price_100g)} / ₱${fmt(p.buy_price_kg)}</td>
        <td>₱ ${fmt(p.adjusted_price)}</td><td>₱ ${fmt(p.sale_per_kg)}</td>
        <td>${fmtKg(p.slab_stock_kg)}</td><td>${fmtKg(p.pack_stock_kg)}</td><td>${p.pack_count}</td>
        <td><b>${fmtKg(tot)}</b></td><td>7.0 kg</td><td>₱ ${fmt(val)}</td>
        <td><button class="btn" onclick='editProduct(${JSON.stringify(p)})'>수정</button></td>
      </tr>`;
    }).join('');
}

function filterProdPart(part, btn) {
  prodPartFilter = part;
  btn.parentElement.querySelectorAll('button').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderProducts();
}

function renderReceivingCalendar() {
  const ym = document.getElementById('rec-cal-month').value || getLocalToday().slice(0, 7);
  document.getElementById('rec-cal-month').value = ym;
  const [y, m] = ym.split('-').map(Number);
  const days = new Date(y, m, 0).getDate();
  const recDates = new Set(STATE.movements.filter(m => m.type === 'product_receiving' || m.type === 'carryover_inbound').map(m => (m.date || '').slice(0, 10)));

  let html = '';
  for (let d = 1; d <= days; d++) {
    const dt = `${ym}-${String(d).padStart(2, '0')}`;
    const has = recDates.has(dt);
    const sel = selectedRecCalDate === dt;
    html += `<div class="cal-cell ${has ? 'has-in' : ''} ${sel ? 'selected' : ''}" onclick="selectedRecCalDate='${dt}';renderReceivingCalendar();renderReceivingTable();">
      ${d}일 ${has ? '✔' : ''}
    </div>`;
  }
  document.getElementById('receiving-calendar').innerHTML = html;
}

function renderReceivingTable() {
  const recMovs = STATE.movements.filter(m => m.type === 'product_receiving' || m.type === 'carryover_inbound');
  const list = selectedRecCalDate ? recMovs.filter(m => (m.date || '').slice(0, 10) === selectedRecCalDate) : recMovs;
  const prodMap = Object.fromEntries(STATE.products.map(p => [p.id, p.name]));

  document.getElementById('receiving-table-body').innerHTML = list.map(m => {
    const isCarry = m.type === 'carryover_inbound';
    const isSlab = (m.slab_kg_delta || 0) > 0 && (m.pack_kg_delta || 0) <= 0;
    const netKg = Number(m.kg_delta || 0);
    const unitPrice = Number(m.unit_price || 0);
    const totalAmt = Number(m.amount || (netKg * unitPrice));

    return `<tr class="clickable-row" onclick='editReceiveMovement(${JSON.stringify(m)})'>
      <td>${m.date}</td>
      <td>${isCarry ? '<span class="badge carry">전월이월</span>' : '<span class="badge ok">상품입고</span>'}</td>
      <td>${isSlab ? '슬랍재고' : '팩재고'}</td>
      <td><b>${prodMap[m.product_id] || '-'}</b></td>
      <td>${m.qty} 팩</td>
      <td><b>${fmtKg(netKg)} KG</b></td>
      <td><b style="color:#166534;">${fmtKg(netKg)} KG</b></td>
      <td>₱ ${fmt(unitPrice)}</td>
      <td><b>₱ ${fmt(totalAmt)}</b></td>
      <td>${m.note}</td>
      <td onclick="event.stopPropagation();">
        <button class="btn" onclick='editReceiveMovement(${JSON.stringify(m)})'>수정</button>
        <button class="btn warn" onclick="deleteMovement(${m.id})">삭제</button>
      </td>
    </tr>`;
  }).join('');
}

function editReceiveMovement(m) {
  showTab('products', document.querySelectorAll('aside .nav')[1]);
  document.getElementById('edit-rec-id').value = m.id;
  document.getElementById('rec-date').value = (m.date || '').slice(0, 10);
  const prod = STATE.products.find(p => p.id === m.product_id);
  if (prod) {
    document.getElementById('rec-meat').value = prod.category;
    updateReceiveProductOptions();
  }
  document.getElementById('rec-prod').value = m.product_id;
  const isSlab = (m.slab_kg_delta || 0) > 0 && (m.pack_kg_delta || 0) <= 0;
  document.getElementById('rec-target').value = isSlab ? 'slab' : 'pack';
  document.getElementById('rec-buy100').value = m.unit_price ? (m.unit_price / 10).toFixed(2) : '';
  const netKg = Number(m.kg_delta || 0);

    new_pid = int(num(d.get("product_id"))) if d.get("product_id") else None
    new_qty = int(num(d.get("qty")))
    new_kg = num(d.get("kg"))
    new_amt = num(d.get("amount"))

    conn = get_db()
    m = conn.execute("SELECT * FROM movements WHERE id=?", (mid,)).fetchone()
    si = conn.execute("SELECT * FROM sales_imports WHERE id=?", (sales_id,)).fetchone()
    if not m or not si:
        conn.close()
        return jsonify({"ok": False, "error": "수정할 판매 항목을 찾을 수 없습니다."})

    save_snapshot(conn, f"판매 실행 항목 수정: #{mid}")

    old_pid = m["product_id"]
    if old_pid:
        old_prod = conn.execute("SELECT * FROM products WHERE id=?", (old_pid,)).fetchone()
        if old_prod:
            r_pack_kg = round(old_prod["pack_stock_kg"] - (m["pack_kg_delta"] or m["kg_delta"] or 0), 3)
            r_slab_kg = round(old_prod["slab_stock_kg"] - (m["slab_kg_delta"] or 0), 3)
            r_cnt = old_prod["pack_count"] + (m["qty"] or 0)
            conn.execute(
                "UPDATE products SET pack_stock_kg=?, slab_stock_kg=?, pack_count=? WHERE id=?",
                (r_pack_kg, r_slab_kg, r_cnt, old_pid)
            )

    pack_deduct_kg = 0.0
    slab_deduct_kg = 0.0
    meat_type = "미매칭"
    ppk = round(new_amt / new_kg, 2) if new_kg != 0 else 0.0
    note_str = f"판매엑셀(수정) [{si['sheet_name']}->{si['deduct_date']}] {new_qty}팩 / {new_kg}kg"

    if new_pid:
        new_prod = conn.execute("SELECT * FROM products WHERE id=?", (new_pid,)).fetchone()
        if new_prod:
            meat_type = new_prod["category"]
            if ppk <= 0:
                ppk = new_prod["sale_per_kg"]
            if new_kg < 0:
                pack_deduct_kg = new_kg
                slab_deduct_kg = 0.0
            else:
                pack_deduct_kg = min(new_prod["pack_stock_kg"], new_kg)
                rem_to_deduct = round(new_kg - pack_deduct_kg, 3)
                slab_deduct_kg = min(new_prod["slab_stock_kg"], rem_to_deduct)

            u_pack_kg = round(new_prod["pack_stock_kg"] - pack_deduct_kg, 3)
            u_slab_kg = round(new_prod["slab_stock_kg"] - slab_deduct_kg, 3)
            u_cnt = new_prod["pack_count"] - new_qty
            conn.execute(
                "UPDATE products SET pack_stock_kg=?, slab_stock_kg=?, pack_count=? WHERE id=?",
                (u_pack_kg, u_slab_kg, u_cnt, new_pid)
            )
            note_str = f"판매엑셀(수정) [{si['sheet_name']}->{si['deduct_date']}] {new_qty}팩 / 팩-{pack_deduct_kg}kg, 슬랍-{slab_deduct_kg}kg 반영"
    else:
        pack_deduct_kg = new_kg

    conn.execute("""
        UPDATE movements SET product_id=?, meat_type=?, qty=?, kg_delta=?,
        slab_kg_delta=?, pack_kg_delta=?, pack_delta=?, unit_price=?, amount=?, price_per_kg=?, note=?
        WHERE id=?
    """, (new_pid, meat_type, new_qty, -new_kg,
          -slab_deduct_kg, -pack_deduct_kg, -new_qty, ppk, new_amt, ppk, note_str, mid))

    recalc_sales_import_summary(conn, si)
    conn.commit()
    conn.close()
    return jsonify({"ok": True})


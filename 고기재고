  }
}

let selectedSalesImportId = null;

function selectSalesDateFromCal(dt) {
  document.getElementById('sales-cal-date').value = dt;
  renderSalesCalendar();
  const matchedImport = (STATE.sales_imports || []).find(s => s.deduct_date === dt || s.sheet_date === dt);
  if (matchedImport) {
    openSalesDetail(matchedImport.id);
  }
}

function renderSalesCalendar() {
  const ym = document.getElementById('sales-cal-month').value || getLocalToday().slice(0, 7);
  document.getElementById('sales-cal-month').value = ym;
  const [y, m] = ym.split('-').map(Number);
  const days = new Date(y, m, 0).getDate();

  const registeredDates = new Set();
  (STATE.sales_imports || []).forEach(s => {
    if (s.deduct_date) registeredDates.add(s.deduct_date);
    if (s.sheet_date) registeredDates.add(s.sheet_date);
  });
  STATE.movements.filter(m => m.type === 'sale').forEach(m => {
    if (m.date) registeredDates.add(m.date.slice(0, 10));
  });

  const selectedDate = document.getElementById('sales-cal-date').value;
  let html = '';
  for (let d = 1; d <= days; d++) {
    const dt = `${ym}-${String(d).padStart(2, '0')}`;
    const has = registeredDates.has(dt);
    const sel = selectedDate === dt;
    html += `<div class="cal-cell ${has ? 'has-sale' : ''} ${sel ? 'selected' : ''}" onclick="selectSalesDateFromCal('${dt}')">
      ${d}일 ${has ? '✔' : ''}
    </div>`;
  }
  document.getElementById('sales-calendar').innerHTML = html;
}

function renderSalesPreviewRows() {
  if (!salesPreviewData) return;
  const prodOpts = '<option value="">-- 미매칭 (선택안함) --</option>' +
    STATE.products.map(p => `<option value="${p.id}">[${p.category}] ${p.name}</option>`).join('');

  document.getElementById('sales-preview-body').innerHTML = salesPreviewData.rows.map((r, idx) => `
    <tr>
      <td>${r.row_no}</td>
      <td>${r.raw_name}</td>
      <td>
        <select onchange="updatePreviewRowProd(${idx}, this.value)">
          ${prodOpts.replace(`value="${r.product_id}"`, `value="${r.product_id}" selected`)}
        </select>
      </td>
      <td><input type="number" value="${r.qty}" style="width:70px;" onchange="salesPreviewData.rows[${idx}].qty=Number(this.value)"></td>
      <td><input type="number" step="0.001" value="${r.kg}" style="width:85px;" onchange="salesPreviewData.rows[${idx}].kg=Number(this.value)"></td>
      <td><input type="number" step="0.01" value="${r.amount}" style="width:95px;" onchange="salesPreviewData.rows[${idx}].amount=Number(this.value)"></td>
      <td>₱ ${fmt(r.price_per_kg)}</td>
      <td><button class="btn warn" onclick="removePreviewRow(${idx})">제외</button></td>
    </tr>
  `).join('');
}

function updatePreviewRowProd(idx, pidVal) {
  const pid = pidVal ? Number(pidVal) : null;
  salesPreviewData.rows[idx].product_id = pid;
  const p = STATE.products.find(x => x.id === pid);
  if (p) {
    salesPreviewData.rows[idx].product_name = p.name;
    if (p.sale_per_kg > 0 && salesPreviewData.rows[idx].amount !== 0) {
      salesPreviewData.rows[idx].kg = Number((salesPreviewData.rows[idx].amount / p.sale_per_kg).toFixed(3));
      salesPreviewData.rows[idx].price_per_kg = p.sale_per_kg;
    }
  }
  renderSalesPreviewRows();
}

function removePreviewRow(idx) {
  salesPreviewData.rows.splice(idx, 1);

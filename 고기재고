@app.route("/api/state", methods=["GET"])
def api_state():
    conn = get_db()
    settings = {r["k"]: r["v"] for r in conn.execute("SELECT * FROM settings").fetchall()}
    products = [dict(r) for r in conn.execute("SELECT * FROM products WHERE active=1 ORDER BY category, cut, name").fetchall()]
    slabs = [dict(r) for r in conn.execute(
        "SELECT * FROM slabs ORDER BY CASE WHEN remaining_kg <= 0.0001 THEN 1 ELSE 0 END ASC, date DESC, id DESC"
    ).fetchall()]
    movements = [dict(r) for r in conn.execute("SELECT * FROM movements ORDER BY date DESC, id DESC LIMIT 2000").fetchall()]
    sales_imports = [dict(r) for r in conn.execute("SELECT * FROM sales_imports ORDER BY id DESC").fetchall()]
    snapshots = [dict(r) for r in conn.execute("SELECT id, created_at, action_label FROM snapshots ORDER BY id DESC").fetchall()]
    conn.close()
    return jsonify({
        "settings": settings,
        "catalog": CATALOG,
        "products": products,
        "slabs": slabs,
        "movements": movements,
        "sales_imports": sales_imports,
        "snapshots": snapshots,
        "db_path": DB_PATH,
        "server_ts": datetime.now().strftime("%H:%M:%S")
    })


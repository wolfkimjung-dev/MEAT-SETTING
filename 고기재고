function renderSlabTable() {
  const todayStr = getLocalToday();
  const meatFilter = document.getElementById('slab-table-meat-filter').value;
  let list = selectedCalDate ? STATE.slabs.filter(s => s.date === selectedCalDate) : STATE.slabs;
  if (meatFilter !== '전체') {
    list = list.filter(s => s.meat_type === meatFilter);
  }
  const prodMap = Object.fromEntries(STATE.products.map(p => [p.id, p.name]));

  document.getElementById('slab-table-body').innerHTML = list.map(s => {
    const isZero = s.remaining_kg <= 0.0001;
    const isNegative = s.remaining_kg < 0;
    const isCarry = Number(s.is_carryover) === 1;
    const isOtherDate = s.date !== todayStr;
    const cls = isNegative ? 'zero-kg' : (isZero ? 'zero-kg' : (isCarry ? 'carryover-row' : (isOtherDate ? 'other-date' : '')));
    const pName = prodMap[s.product_id] || '-';
    return `<tr class="clickable-row ${cls}" onclick='editSlab(${JSON.stringify(s)})'>
      <td>${s.date}</td>
      <td>${isCarry ? '<span class="badge carry">전월이월</span>' : '<span class="badge ok">당월입고</span>'}</td>
      <td>${s.meat_type}</td><td>${s.cut}</td><td><b>${pName}</b></td><td><b>${s.slab_no || '-'}</b></td>
      <td>${fmtKg(s.kg)}</td><td><b>${fmtKg(s.remaining_kg)}</b></td><td>₱ ${fmt(s.buy_price_kg)}</td>
      <td>${isNegative ? '음수초과' : (isZero ? '소진(0KG)' : '보유중')}</td>
      <td onclick="event.stopPropagation();">
        <button class="btn" onclick='editSlab(${JSON.stringify(s)})'>수정</button>
        <button class="btn warn" onclick='deleteSlab(${s.id})'>삭제</button>
      </td>
    </tr>`;
  }).join('');
}

function renderProductionTable() {
  const prodMovs = STATE.movements.filter(m => m.type === 'slab_production');
  const list = selectedProdCalDate ? prodMovs.filter(m => (m.date || '').slice(0, 10) === selectedProdCalDate) : prodMovs;
  const prodMap = Object.fromEntries(STATE.products.map(p => [p.id, p.name]));
  const slabMap = Object.fromEntries(STATE.slabs.map(s => [s.id, s]));

  document.getElementById('production-table-body').innerHTML = list.map(m => {
    const slab = slabMap[m.slab_id] || {};
    const inputKg = Math.abs(m.slab_kg_delta || 0);
    const outKg = Math.abs(m.pack_kg_delta || m.kg_delta || 0);
    const packs = Math.abs(m.pack_delta || m.qty || 0);
    const unitKg = packs > 0 ? (inputKg / packs) : 0;
    const prodName = prodMap[m.product_id] || '-';
    return `<tr class="clickable-row" onclick='editProduction(${JSON.stringify(m)})'>
      <td>${m.date}</td>
      <td>${m.meat_type}</td>
      <td>#${slab.slab_no || m.slab_id} (${slab.cut || ''})</td>
      <td><b>${prodName}</b></td>
      <td>${fmtKg(inputKg)} KG</td>
      <td>${packs} 팩</td>
      <td><b style="color:#166534;">${fmtKg(unitKg)} KG/팩</b></td>
      <td><b>${fmtKg(outKg)} KG</b></td>

  // 육종별(돼지고기, 소고기, 닭고기) 순구매 KG 및 금액 집계
  const meatStats = { "돼지고기": {kg:0, amt:0}, "소고기": {kg:0, amt:0}, "닭고기": {kg:0, amt:0} };
  lastReportRows.forEach(r => {

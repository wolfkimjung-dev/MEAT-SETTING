async function saveProduct() {
  const payload = {
    id: document.getElementById('edit-prod-id').value || null,
    category: document.getElementById('prod-cat').value,
    cut: document.getElementById('prod-cut').value,
    name: document.getElementById('prod-name').value,
    barcode: document.getElementById('prod-barcode').value,
    buy_price_100g: document.getElementById('prod-buy100').value,
    adjusted_price: document.getElementById('prod-adj').value,
    sale_per_kg: document.getElementById('prod-sale').value,
    slab_stock_kg: document.getElementById('prod-slab-kg').value,
    pack_stock_kg: document.getElementById('prod-pack-kg').value,
    pack_count: document.getElementById('prod-pack-cnt').value,
    min_stock_kg: 7.0
  };
  const res = await fetch('/api/products/save', {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)});
  const data = await res.json();
  if (!data.ok) return alert(data.error);
  toast('상품 카탈로그/재고가 저장되었습니다 (안전재고 7kg 적용).');
  resetProdForm();
  await loadState();
}

async function submitProductReceive() {
  const editId = document.getElementById('edit-rec-id').value;
  const endpoint = editId ? '/api/products/receive/update' : '/api/products/receive';
  const payload = {
    id: editId || null,
    date: document.getElementById('rec-date').value,
    product_id: document.getElementById('rec-prod').value,
    target_type: document.getElementById('rec-target').value,
    buy_price_100g: document.getElementById('rec-buy100').value,
    kg: document.getElementById('rec-kg').value,
    packs: document.getElementById('rec-packs').value,
    is_carryover: document.getElementById('rec-carryover').checked
  };
  const res = await fetch(endpoint, {method: 'POST', headers: {'Content-Type': 'application/json'}, body: JSON.stringify(payload)});
  const data = await res.json();
  if (!data.ok) return alert(data.error);
  toast(editId ? '상품 입고 내역이 수정되고 재고가 재계산되었습니다.' : (payload.is_carryover ? '전월 이월 재고가 반영되었습니다 (구매KG 제외).' : '상품 입고가 반영되었습니다.'));
  resetReceiveForm();
  await loadState();
}


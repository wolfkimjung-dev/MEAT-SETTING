@app.route("/api/slabs/production", methods=["POST"])
def api_slab_production():
    d = request.json or {}
    conn = get_db()
    p_date = str(d.get("date") or date.today().isoformat())
    slab_id = int(num(d.get("slab_id")))
    product_id = int(num(d.get("product_id")))
    input_kg = num(d.get("input_kg"))
    pack_unit_kg = num(d.get("pack_unit_kg"))
    packs = int(num(d.get("packs")))
    out_kg = round(pack_unit_kg * packs, 3) if pack_unit_kg > 0 and packs > 0 else num(d.get("output_kg"))

    slab = conn.execute("SELECT * FROM slabs WHERE id=?", (slab_id,)).fetchone()
    prod = conn.execute("SELECT * FROM products WHERE id=?", (product_id,)).fetchone()
    if not slab or not prod or input_kg <= 0:
        conn.close()
        return jsonify({"ok": False, "error": "입고 날짜별 슬랍과 생산 상품, 투입 KG를 정확히 입력하세요."})

    save_snapshot(conn, f"슬랍 생산반영: {slab['slab_no']} -> {prod['name']}")
    rem = round(slab["remaining_kg"] - input_kg, 3)
    status = "done" if rem <= 0.0001 else "open"

    conn.execute("UPDATE slabs SET remaining_kg=?, status=? WHERE id=?", (rem, status, slab_id))
    
    target_slab_pid = slab.get("product_id")
    if not target_slab_pid:
        match_p = resolve_slab_product(conn, None, slab["meat_type"], slab["cut"])
        if match_p:
            target_slab_pid = match_p["id"]
    
    if target_slab_pid:
        conn.execute("UPDATE products SET slab_stock_kg = ROUND(slab_stock_kg - ?, 3) WHERE id=?",
                     (input_kg, target_slab_pid))

    conn.execute("UPDATE products SET pack_stock_kg = ROUND(pack_stock_kg + ?, 3), pack_count = pack_count + ? WHERE id=?",
                 (out_kg, packs, product_id))

    conn.execute("""
        INSERT INTO movements (date, created_at, type, product_id, slab_id, meat_type, qty, kg_delta,
        slab_kg_delta, pack_kg_delta, pack_delta, loss_kg, unit_price, amount, price_per_kg, note)
        VALUES (?, ?, 'slab_production', ?, ?, ?, ?, ?, ?, ?, ?, 0, ?, ?, ?, ?)
    """, (p_date, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), product_id, slab_id, slab["meat_type"],
          packs, out_kg, -input_kg, out_kg, packs,
          slab["buy_price_kg"], round(out_kg * prod["sale_per_kg"], 2), prod["sale_per_kg"],
          f"생산반영 (슬랍 #{slab['slab_no'] or slab['id']} 투입 {input_kg}kg -> {packs}팩/{out_kg}kg)"))
    conn.commit()
    conn.close()
    return jsonify({"ok": True})


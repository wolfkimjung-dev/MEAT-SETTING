        else:
            pack_deduct_kg = min(prod["pack_stock_kg"], kg)
            rem_to_deduct = round(kg - pack_deduct_kg, 3)
            slab_deduct_kg = min(prod["slab_stock_kg"], rem_to_deduct)

        new_pack_kg = round(prod["pack_stock_kg"] - pack_deduct_kg, 3)
        new_slab_kg = round(prod["slab_stock_kg"] - slab_deduct_kg, 3)
        new_pack_cnt = prod["pack_count"] - qty

        conn.execute(
            "UPDATE products SET pack_stock_kg=?, slab_stock_kg=?, pack_count=? WHERE id=?",
            (new_pack_kg, new_slab_kg, new_pack_cnt, pid)
        )

        conn.execute("""
            INSERT INTO movements (date, created_at, type, product_id, meat_type, qty, kg_delta,
            slab_kg_delta, pack_kg_delta, pack_delta, unit_price, amount, price_per_kg, note)
            VALUES (?, ?, 'sale', ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
        """, (deduct_date, now_str, pid, prod["category"], qty, -kg,
              -slab_deduct_kg, -pack_deduct_kg, -qty, ppk, amt, ppk,
              f"판매엑셀 [{sheet_name}->{deduct_date}] {qty}팩 / 팩-{pack_deduct_kg}kg, 슬랍-{slab_deduct_kg}kg 반영"))

        total_qty += qty
        total_kg = round(total_kg + kg, 3)
        total_amount = round(total_amount + amt, 2)

    conn.execute("""
        INSERT INTO sales_imports (file_name, sheet_name, sheet_date, deduct_date, imported_at, total_qty, total_kg, total_amount, status)
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'done')
    """, (file_name, sheet_name, sheet_date, deduct_date, now_str, total_qty, total_kg, total_amount))

    conn.commit()
    conn.close()
    return jsonify({"ok": True})

def build_report_data(start_dt, end_dt, meat_filter="전체"):
    conn = get_db()
    settings = {r["k"]: r["v"] for r in conn.execute("SELECT * FROM settings").fetchall()}
    fixed_loss_pct = num(settings.get("fixed_loss_rate", 20.0))

    products = [dict(r) for r in conn.execute("SELECT * FROM products WHERE active=1 ORDER BY category, cut, name").fetchall()]
    slabs = [dict(r) for r in conn.execute("SELECT * FROM slabs").fetchall()]
    movs = [dict(r) for r in conn.execute(
        "SELECT * FROM movements WHERE substr(date,1,10) BETWEEN ? AND ?", (start_dt, end_dt)
    ).fetchall()]
    conn.close()

    slab_map = {s["id"]: s for s in slabs}
    type_label_map = {
        "product_receiving": "상품입고",
        "carryover_inbound": "전월이월(상품)",
        "slab_inbound": "슬랍입고",
        "slab_carryover": "전월이월(슬랍)",
        "slab_production": "생산반영",
        "trim": "트림(정형손실)",
        "waste": "폐기손실",
        "sale": "판매차감"
    }

    report_rows = []
    for p in products:
        if meat_filter != "전체" and p["category"] != meat_filter:
            continue
        p_movs = [m for m in movs if m["product_id"] == p["id"]]
        
        buy_kg = sum(m["kg_delta"] for m in p_movs if m["type"] in ("product_receiving", "slab_inbound") and m["kg_delta"] > 0)
        carryover_kg = sum(m["kg_delta"] for m in p_movs if m["type"] in ("carryover_inbound", "slab_carryover"))
        buy_amt = sum(m["amount"] for m in p_movs if m["type"] in ("product_receiving", "slab_inbound"))

        trim_kg = sum(m["trim_kg"] for m in p_movs if m["type"] == "trim")
        waste_kg = sum(m["waste_kg"] for m in p_movs if m["type"] == "waste")
        total_loss_kg = round(trim_kg + waste_kg, 3)

        sale_qty = sum(m["qty"] for m in p_movs if m["type"] == "sale")
        sale_kg = sum((-m["kg_delta"]) for m in p_movs if m["type"] == "sale")
        sale_amt = sum(m["amount"] for m in p_movs if m["type"] == "sale")

        expected_loss_kg = round(buy_kg * (fixed_loss_pct / 100.0), 3)
        loss_base_kg = buy_kg if buy_kg > 0 else (sale_kg + total_loss_kg)
        actual_loss_rate = round((total_loss_kg / loss_base_kg) * 100.0, 2) if loss_base_kg > 0 else 0.0
        loss_amt = round(total_loss_kg * p["buy_price_kg"], 2)

        cogs_amt = round(sale_kg * p["adjusted_price"], 2)
        profit = round(sale_amt - cogs_amt - loss_amt, 2)
        profit_rate = round((profit / sale_amt) * 100.0, 2) if sale_amt > 0 else 0.0
        net_margin_vs_loss = round(profit_rate - actual_loss_rate, 2)
        tot_stock = round(p["slab_stock_kg"] + p["pack_stock_kg"], 3)

        detail_logs = []
        for m in sorted(p_movs, key=lambda x: (x["date"], x["id"]), reverse=True):
            s_info = slab_map.get(m["slab_id"])
            origin = f"슬랍 #{s_info['slab_no'] or s_info['id']} ({s_info['cut']})" if s_info else (
                "팩재고" if abs(m["pack_kg_delta"] or 0) > 0 else ("슬랍재고" if abs(m["slab_kg_delta"] or 0) > 0 else "직접입력")
            )
            detail_logs.append({
                "id": m["id"],
                "date": m["date"],
                "type": m["type"],
                "type_label": type_label_map.get(m["type"], m["type"]),
                "origin": origin,
                "qty": m["qty"],
                "kg_delta": round(m["kg_delta"] or 0, 3),
                "slab_kg_delta": round(m["slab_kg_delta"] or 0, 3),
                "pack_kg_delta": round(m["pack_kg_delta"] or 0, 3),
                "trim_kg": round(m["trim_kg"] or 0, 3),
                "waste_kg": round(m["waste_kg"] or 0, 3),
                "total_loss_kg": round(m["trim_kg"] or 0, 3) + round(m["waste_kg"] or 0, 3),
                "amount": round(m["amount"] or 0, 2),
                "note": m["note"] or ""
            })

        report_rows.append({
            "id": p["id"],
            "category": p["category"],
            "cut": p["cut"],
            "name": p["name"],
            "last_buy_price": p["buy_price_kg"],
            "adjusted_price": p["adjusted_price"],
            "sale_per_kg": p["sale_per_kg"],
            "carryover_kg": round(carryover_kg, 3),
            "buy_kg": round(buy_kg, 3),
            "buy_amt": round(buy_amt, 2),
            "slab_stock_kg": round(p["slab_stock_kg"], 3),
            "pack_stock_kg": round(p["pack_stock_kg"], 3),
            "pack_count": p["pack_count"],
            "total_stock_kg": tot_stock,
            "min_stock_kg": 7.0,
            "stock_value": round(tot_stock * p["sale_per_kg"], 2),
            "expected_loss_kg": expected_loss_kg,
            "trim_kg": round(trim_kg, 3),
            "waste_kg": round(waste_kg, 3),
            "total_loss_kg": total_loss_kg,
            "actual_loss_rate": actual_loss_rate,
            "loss_amt": loss_amt,
            "sale_qty": sale_qty,
            "sale_kg": round(sale_kg, 3),
            "sale_amt": round(sale_amt, 2),
            "profit": profit,
            "profit_rate": profit_rate,
            "net_margin_vs_loss": net_margin_vs_loss,
            "detail_logs": detail_logs
        })
    return fixed_loss_pct, report_rows

@app.route("/api/report", methods=["GET"])
def api_report():
    start_dt = request.args.get("start") or date.today().replace(day=1).isoformat()
    end_dt = request.args.get("end") or date.today().isoformat()
    meat_filter = request.args.get("meat") or "전체"
    fixed_loss_pct, report_rows = build_report_data(start_dt, end_dt, meat_filter)
    return jsonify({"ok": True, "fixed_loss_pct": fixed_loss_pct, "rows": report_rows})

@app.route("/api/backup/export", methods=["GET"])
def api_backup_export():
    conn = get_db()
    payload = {
        "products": [dict(r) for r in conn.execute("SELECT * FROM products").fetchall()],
        "slabs": [dict(r) for r in conn.execute("SELECT * FROM slabs").fetchall()],
        "movements": [dict(r) for r in conn.execute("SELECT * FROM movements").fetchall()],
        "sales_imports": [dict(r) for r in conn.execute("SELECT * FROM sales_imports").fetchall()],
        "settings": [dict(r) for r in conn.execute("SELECT * FROM settings").fetchall()]
    }
    conn.close()
    bio = io.BytesIO(json.dumps(payload, ensure_ascii=False, indent=2).encode('utf-8'))

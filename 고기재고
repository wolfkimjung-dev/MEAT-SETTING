        return jsonify({"ok": False, "error": "슬랍 중량(KG)을 입력하세요."})

    label_tag = "전월이월 슬랍" if is_carryover else "슬랍 입고"
    save_snapshot(conn, f"{label_tag} {'수정' if sid else '등록'}: {slab_no or cut} ({kg}kg)")

    if sid:
        old = conn.execute("SELECT * FROM slabs WHERE id=?", (sid,)).fetchone()
        if not old:
            conn.close()
            return jsonify({"ok": False, "error": "수정할 슬랍을 찾을 수 없습니다."})

        old_pid = old["product_id"]
        if not old_pid:
            mp = resolve_slab_product(conn, None, old["meat_type"], old["cut"])
            if mp: old_pid = mp["id"]

        if old_pid and old["remaining_kg"] != 0:
            conn.execute("UPDATE products SET slab_stock_kg = ROUND(slab_stock_kg - ?, 3) WHERE id=?",
                         (old["remaining_kg"], old_pid))

        consumed_kg = old["kg"] - old["remaining_kg"]
        new_rem = round(kg - consumed_kg, 3)
        status = "done" if new_rem <= 0.0001 else "open"

        if linked_pid:
            conn.execute("UPDATE products SET slab_stock_kg = ROUND(slab_stock_kg + ?, 3) WHERE id=?",
                         (new_rem, linked_pid))

        conn.execute("""
            UPDATE slabs SET date=?, meat_type=?, cut=?, product_id=?, slab_no=?, kg=?, remaining_kg=?,
            buy_price_100g=?, buy_price_kg=?, is_carryover=?, status=? WHERE id=?
        """, (s_date, meat_type, cut, linked_pid, slab_no, kg, new_rem, buy_100g, buy_kg, is_carryover, status, sid))
        
        mov_type = "slab_carryover" if is_carryover else "slab_inbound"
        conn.execute("""
            UPDATE movements SET date=?, type=?, product_id=?, meat_type=?, kg_delta=?, slab_kg_delta=?,
            unit_price=?, amount=?, price_per_kg=?, note=?
            WHERE slab_id=? AND type IN ('slab_inbound', 'slab_carryover')
        """, (s_date, mov_type, linked_pid, meat_type, kg, kg, buy_kg, round(kg * buy_kg, 2), buy_kg,
              f"{label_tag} ({slab_no or cut})", sid))
    else:
        cur = conn.execute("""
            INSERT INTO slabs (date, meat_type, cut, product_id, slab_no, kg, remaining_kg, buy_price_100g, buy_price_kg, is_carryover, status)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'open')
        """, (s_date, meat_type, cut, linked_pid, slab_no, kg, kg, buy_100g, buy_kg, is_carryover))
        new_sid = cur.lastrowid
        
        if linked_pid:
            conn.execute("UPDATE products SET slab_stock_kg = ROUND(slab_stock_kg + ?, 3) WHERE id=?", (kg, linked_pid))
        
        mov_type = "slab_carryover" if is_carryover else "slab_inbound"
        conn.execute("""
            INSERT INTO movements (date, created_at, type, product_id, slab_id, meat_type, qty, kg_delta, slab_kg_delta, unit_price, amount, price_per_kg, note)
            VALUES (?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?, ?, ?)
        """, (s_date, datetime.now().strftime("%Y-%m-%d %H:%M:%S"), mov_type, linked_pid, new_sid, meat_type,
              kg, kg, buy_kg, round(kg * buy_kg, 2), buy_kg, f"{label_tag} ({slab_no or cut})"))
    conn.commit()
    conn.close()
    return jsonify({"ok": True})


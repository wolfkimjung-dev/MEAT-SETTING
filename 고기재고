def normalize_key(s):
    if not s:
        return ""
    return re.sub(r'[\s_\-/]+', '', str(s).lower())

def num(v):
    if v is None:
        return 0.0
    if isinstance(v, (int, float)):
        return float(v)
    s = str(v).replace(',', '').replace('₱', '').replace('₩', '').replace('원', '').replace('$', '').strip()
    try:
        return float(s)
    except ValueError:
        return 0.0

def get_db():
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA journal_mode=WAL;")
    return conn

def init_db():
    conn = get_db()
    c = conn.cursor()
    c.execute("CREATE TABLE IF NOT EXISTS settings (k TEXT PRIMARY KEY, v TEXT)")
    c.execute("INSERT OR IGNORE INTO settings (k, v) VALUES ('fixed_loss_rate', '20.0')")
    c.execute("INSERT OR IGNORE INTO settings (k, v) VALUES ('margin_rate', '35.0')")

    c.execute("""
    CREATE TABLE IF NOT EXISTS products (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        name TEXT NOT NULL,
        name_key TEXT NOT NULL,
        barcode TEXT DEFAULT '',
        category TEXT DEFAULT '돼지고기',
        cut TEXT DEFAULT '',
        stock_kind TEXT DEFAULT 'pack',
        buy_price_100g REAL DEFAULT 0,
        buy_price_kg REAL DEFAULT 0,
        adjusted_price REAL DEFAULT 0,
        sale_per_kg REAL DEFAULT 0,
        slab_stock_kg REAL DEFAULT 0,
        pack_stock_kg REAL DEFAULT 0,
        pack_count INTEGER DEFAULT 0,
        min_stock_kg REAL DEFAULT 7.0,
        active INTEGER DEFAULT 1
    )""")

    p_cols = [r["name"] for r in c.execute("PRAGMA table_info(products)").fetchall()]
    if "min_stock_kg" not in p_cols:
        c.execute("ALTER TABLE products ADD COLUMN min_stock_kg REAL DEFAULT 7.0")

    c.execute("""
    CREATE TABLE IF NOT EXISTS slabs (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        date TEXT NOT NULL,
        meat_type TEXT NOT NULL,
        cut TEXT DEFAULT '',
        product_id INTEGER,
        slab_no TEXT DEFAULT '',
        kg REAL DEFAULT 0,
        remaining_kg REAL DEFAULT 0,
        buy_price_100g REAL DEFAULT 0,
        buy_price_kg REAL DEFAULT 0,
        is_carryover INTEGER DEFAULT 0,
        status TEXT DEFAULT 'open'
    )""")

    s_cols = [r["name"] for r in c.execute("PRAGMA table_info(slabs)").fetchall()]
    if "is_carryover" not in s_cols:
        c.execute("ALTER TABLE slabs ADD COLUMN is_carryover INTEGER DEFAULT 0")
    if "product_id" not in s_cols:
        c.execute("ALTER TABLE slabs ADD COLUMN product_id INTEGER")

    c.execute("""
    CREATE TABLE IF NOT EXISTS movements (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        date TEXT NOT NULL,
        created_at TEXT NOT NULL,
        type TEXT NOT NULL,
        product_id INTEGER,
        slab_id INTEGER,
        meat_type TEXT DEFAULT '',
        qty INTEGER DEFAULT 0,
        kg_delta REAL DEFAULT 0,
        slab_kg_delta REAL DEFAULT 0,
        pack_kg_delta REAL DEFAULT 0,
        pack_delta INTEGER DEFAULT 0,
        loss_kg REAL DEFAULT 0,
        trim_kg REAL DEFAULT 0,
        waste_kg REAL DEFAULT 0,
        unit_price REAL DEFAULT 0,
        amount REAL DEFAULT 0,
        price_per_kg REAL DEFAULT 0,
        note TEXT DEFAULT ''
    )""")

    c.execute("""
    CREATE TABLE IF NOT EXISTS sales_imports (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        file_name TEXT NOT NULL,
        sheet_name TEXT NOT NULL,
        sheet_date TEXT NOT NULL,
        deduct_date TEXT NOT NULL,
        imported_at TEXT NOT NULL,
        total_qty INTEGER DEFAULT 0,
        total_kg REAL DEFAULT 0,
        total_amount REAL DEFAULT 0,
        status TEXT DEFAULT 'done'
    )""")

    c.execute("""
    CREATE TABLE IF NOT EXISTS snapshots (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        created_at TEXT NOT NULL,
        action_label TEXT NOT NULL,
        payload TEXT NOT NULL
    )""")

    cnt = c.execute("SELECT COUNT(*) FROM products").fetchone()[0]
    if cnt == 0:
        for meat, cuts in CATALOG.items():
            for cut, names in cuts.items():
                for nm in names:
                    c.execute(
                        "INSERT INTO products (name, name_key, category, cut, stock_kind, min_stock_kg) VALUES (?, ?, ?, ?, 'pack', 7.0)",
                        (nm, normalize_key(nm), meat, cut)
                    )
    conn.commit()
    conn.close()

def resolve_slab_product(conn, product_id, meat_type, cut):
    if product_id:
        p = conn.execute("SELECT * FROM products WHERE id=?", (int(num(product_id)),)).fetchone()
        if p:
            return p
    if cut:
        ck = normalize_key(cut)
        p = conn.execute(
            "SELECT * FROM products WHERE category=? AND (name_key LIKE ? OR cut LIKE ?) ORDER BY id ASC LIMIT 1",
            (meat_type, f"%{ck}%", f"%{cut}%")
        ).fetchone()
        if p:
            return p
    return conn.execute("SELECT * FROM products WHERE category=? ORDER BY id ASC LIMIT 1", (meat_type,)).fetchone()

def calc_prices(buy_100g, fixed_loss_pct=20.0, margin_pct=35.0):
    buy_100g = num(buy_100g)
    buy_kg = round(buy_100g * 10.0, 2)
    loss_factor = max(0.05, 1.0 - (num(fixed_loss_pct) / 100.0))
    adj_price = round(buy_kg / loss_factor, 2)
    sale_price = round(adj_price * (1.0 + (num(margin_pct) / 100.0)), 2)
    return buy_kg, adj_price, sale_price

def save_snapshot(conn, label):
    payload = json.dumps({
        "products": [dict(r) for r in conn.execute("SELECT * FROM products").fetchall()],
        "slabs": [dict(r) for r in conn.execute("SELECT * FROM slabs").fetchall()],
        "movements": [dict(r) for r in conn.execute("SELECT * FROM movements").fetchall()],
        "sales_imports": [dict(r) for r in conn.execute("SELECT * FROM sales_imports").fetchall()],
        "settings": [dict(r) for r in conn.execute("SELECT * FROM settings").fetchall()]
    }, ensure_ascii=False)
    conn.execute(
        "INSERT INTO snapshots (created_at, action_label, payload) VALUES (?, ?, ?)",
        (datetime.now().strftime("%Y-%m-%d %H:%M:%S"), label, payload)
    )
    conn.execute("DELETE FROM snapshots WHERE id NOT IN (SELECT id FROM snapshots ORDER BY id DESC LIMIT 30)")


function renderCalendar() {
  const ym = document.getElementById('cal-month').value || getLocalToday().slice(0, 7);
  document.getElementById('cal-month').value = ym;
  const [y, m] = ym.split('-').map(Number);
  const days = new Date(y, m, 0).getDate();
  const inboundDates = new Set(STATE.slabs.map(s => s.date));

  let html = '';
  for (let d = 1; d <= days; d++) {
    const dt = `${ym}-${String(d).padStart(2, '0')}`;
    const has = inboundDates.has(dt);
    const sel = selectedCalDate === dt;
    html += `<div class="cal-cell ${has ? 'has-in' : ''} ${sel ? 'selected' : ''}" onclick="selectedCalDate='${dt}';renderCalendar();renderSlabTable();">
      ${d}일 ${has ? '✔' : ''}
    </div>`;
  }
  document.getElementById('slab-calendar').innerHTML = html;
}


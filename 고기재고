@app.route("/api/sales/preview", methods=["POST"])
@app.route("/api/sales_preview", methods=["POST"])
def api_sales_preview():
    f = request.files.get("file")
    selected_date_str = request.form.get("selected_date", "").strip()
    if not f:
        return jsonify({"ok": False, "error": "엑셀 파일을 선택하세요."})

    wb = openpyxl.load_workbook(f, data_only=True)
    sheet_names = wb.sheetnames
    target_sheet, sheet_dt = None, None

    if selected_date_str:
        try:
            base_dt = datetime.strptime(selected_date_str, "%Y-%m-%d").date()
        except ValueError:
            base_dt = date.today()
    else:
        base_dt = date.today()

    target_dt = base_dt - timedelta(days=1)
    target_mmdd = target_dt.strftime("%m%d")

    for s in sheet_names:
        clean_s = re.sub(r'[^0-9]', '', str(s))
        if target_mmdd in clean_s:
            target_sheet = s
            sheet_dt = target_dt
            break

    if not target_sheet:
        target_sheet = sheet_names[0]
        sheet_dt = target_dt

    deduct_dt = sheet_dt

    ws = wb[target_sheet]
    conn = get_db()
    products = [dict(r) for r in conn.execute("SELECT * FROM products WHERE active=1").fetchall()]
    already = conn.execute(
        "SELECT * FROM sales_imports WHERE sheet_name=? AND deduct_date=?",
        (target_sheet, deduct_dt.isoformat())
    ).fetchone()
    conn.close()

    rows = []
    for idx, row in enumerate(ws.iter_rows(min_row=2, values_only=True), start=2):
        af = row[31] if len(row) > 31 else None
        ag = row[32] if len(row) > 32 else None
        ah = row[33] if len(row) > 33 else None

        name = str(af or "").strip()
        if not name and len(row) >= 3:
            for c_val in row[:6]:
                if isinstance(c_val, str) and len(c_val.strip()) > 1:
                    name = c_val.strip()
                    break
        if not name:
            continue

        nk = normalize_key(name)
        matched = next((p for p in products if p["name_key"] == nk), None)
        if not matched:
            matched = next((p for p in products if nk in p["name_key"] or p["name_key"] in nk), None)

        qty = int(num(ag))
        amount = num(ah)
        sale_price = num(matched["sale_per_kg"]) if matched else 0.0
        kg = round(amount / sale_price, 3) if sale_price > 0 and amount != 0 else 0.0
        price_per_kg = round(amount / kg, 2) if kg != 0 else sale_price

        if qty == 0 and amount == 0 and kg == 0:
            continue

        rows.append({
            "row_no": idx,
            "raw_name": name,
            "product_id": matched["id"] if matched else None,
            "product_name": matched["name"] if matched else "매칭 실패",
            "qty": qty,
            "kg": kg,
            "amount": amount,
            "price_per_kg": price_per_kg
        })

    return jsonify({
        "ok": True,
        "file_name": f.filename,
        "sheet_names": sheet_names,
        "target_sheet": target_sheet,
        "sheet_date": sheet_dt.isoformat(),
        "deduct_date": deduct_dt.isoformat(),
        "deduct_mmdd": deduct_dt.strftime("%m%d"),
        "already_imported": bool(already),
        "rows": rows
    })

